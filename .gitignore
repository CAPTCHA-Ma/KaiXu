gradle.local.properties
key.properties
keystore.properties
signing.properties
*.jks
*.keystore
*.p12
*.pfx

# IDE 与编辑器本机文件
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# 本地 AI 工具配置（各人本机使用，不随仓库共享）
.agents/
.claude/
.dsh/
.opencode/
.trae/

# VS Code：保留可共享的扩展推荐与运行任务
!**/.vscode/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json

# 环境变量文件：保留不含真实凭据的配置模板
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Python 虚拟环境、字节码与构建产物
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/services/api/dist/

# Python 测试、检查与覆盖率缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
